#!/usr/bin/env bash
# clangd上ではclangdの内蔵デフォルトにより一部のclang-tidyチェック
# (bugprone-unchecked-optional-access等)が抑制され、エディタ上で検知できない。
# そのためコミット時にrun-clang-tidy-19でプロジェクト全体を検査する。
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# src/配下のC/C++ファイルに変更がなければ検査不要
if ! git diff --cached --name-only --diff-filter=ACM | grep -qE '^src/.*\.(cpp|h|hpp)$'; then
  exit 0
fi

compile_db="build/Debug/compile_commands.json"
if [ ! -f "$compile_db" ]; then
  echo "エラー: ${compile_db} が見つかりません。先に以下を実行してください:" >&2
  echo "  cmake --preset conan-debug && cmake --build --preset conan-debug" >&2
  exit 1
fi

# clang-tidyのv19系（clangdとバージョンを揃える）を探す。
# - Linux (APT): run-clang-tidy-19 がPATH上にあるので、従来通りそれを使う。
# - macOS (Homebrew): llvm@19 はkeg-only（/opt/homebrew/bin等にリンクされない）で、
#   run-clang-tidy-19 という名前のコマンドも存在しない。そこで `brew --prefix llvm@19`
#   配下の run-clang-tidy を使う。run-clang-tidy は既定でPATH上の clang-tidy を探して
#   しまうため、-clang-tidy-binary で同じllvm@19の clang-tidy を明示的に指定する。
run_clang_tidy_cmd=()
if command -v run-clang-tidy-19 >/dev/null 2>&1; then
  run_clang_tidy_cmd=(run-clang-tidy-19)
elif command -v brew >/dev/null 2>&1 \
  && llvm19_prefix="$(brew --prefix llvm@19 2>/dev/null)" \
  && [ -x "${llvm19_prefix}/bin/run-clang-tidy" ] \
  && [ -x "${llvm19_prefix}/bin/clang-tidy" ]; then
  run_clang_tidy_cmd=("${llvm19_prefix}/bin/run-clang-tidy" -clang-tidy-binary "${llvm19_prefix}/bin/clang-tidy")
fi

if [ ${#run_clang_tidy_cmd[@]} -eq 0 ]; then
  echo "エラー: clang-tidy v19系が見つかりません。以下のいずれかでインストールしてください:" >&2
  echo "  Linux: sudo apt install clang-tidy-19" >&2
  echo "  macOS: brew install llvm@19" >&2
  exit 1
fi

echo "clang-tidy-19でsrc/を検査しています..."
output="$("${run_clang_tidy_cmd[@]}" -p build/Debug src/ 2>&1)" || true

if grep -q "warning:" <<< "$output"; then
  grep "warning:" <<< "$output" >&2
  echo "" >&2
  echo "clang-tidyの警告が見つかったためコミットを中止しました。修正するか、緊急時は 'git commit --no-verify' で回避してください。" >&2
  exit 1
fi

exit 0
