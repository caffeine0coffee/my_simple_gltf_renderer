// Project-local debug configurations.
// See: https://zed.dev/docs/debugger
//
// 起動前に "CMake build (conan-debug)" タスク（.zed/tasks.json）で
// ビルドしてから gltf_renderer をデバッガ配下で起動する。
[
  {
    "label": "Debug gltf_renderer",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/Debug/gltf_renderer",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    // 起動前にビルドを実行する（tasks.json のラベルを参照）
    "build": "CMake build (conan-debug)"
  },
  {
    // ビルド済みバイナリにそのままアタッチ/起動したい場合（ビルドをスキップ）
    "label": "Debug gltf_renderer (no build)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/Debug/gltf_renderer",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": []
  }
]
